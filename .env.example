# ================================================
# NHA FIMS - Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to git
# ================================================

APP_ENV=development
APP_DEBUG=true

# ================================================
# DATABASE (PostgreSQL)
# ================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=govflow360_nha

# ================================================
# SMTP (Email)
# ================================================
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=

# ================================================
# JWT
# ================================================
JWT_SECRET=change_me_in_production
JWT_EXPIRE_TIME=600
# LIBIS_JWT_EXPIRE_TIME=600  # optional override for LIBIS/api/v1/login only; unset = no practical idle logout (~10yr), independent of JWT_EXPIRE_TIME above

# ================================================
# EMQX (MQTT Broker)
# ================================================
EMQX_API_URL=http://152.42.249.97:18083
EMQX_API_KEY=
EMQX_API_SECRET=

# ================================================
# REDIS
# ================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=bull:dgtms:queue:
REDIS_TIMEOUT=30

# ================================================
# DIGITAL OCEAN SPACES (S3)
# ================================================
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_BUCKET=pg-itbs-dev
DO_SPACES_REGION=sgp1
DO_SPACES_KEY=
DO_SPACES_SECRET=

# ================================================
# API URLs
# ================================================
API_BASE_URL=http://nha-fims.localhost
API_DOCKER_URL=http://host.docker.internal:3000/UAC/api
API_FMD_URL=/FMD/api
API_UAC_URL=/UAC/api
API_ACCOUNTING_DCD_URL=http://nha-fims.localhost/ACCOUNTING-DCD/api
API.REGIONAL_URL=/REGIONAL/api
API.GSD_URL=/GSD/api
API.FIMS_URL=/api

# ================================================
# ONLYOFFICE
# ================================================
ONLYOFFICE_JWT_SECRET=change_me_in_production
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_SERVER_URL=http://localhost:8080
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8080

# ================================================
# OPENAI
# ================================================
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ================================================
# MICROSOFT SPEECH
# ================================================
MICROSOFT_SPEECH_API_KEY=
MICROSOFT_SPEECH_REGION=eastus
MICROSOFT_SPEECH_LANGUAGE=en-US

# ================================================
# UPLOADS
# ================================================
# Docker/Linux:
UPLOAD_TEMP_PATH=/var/www/html/temp_uploads/
# Server:
# UPLOAD_TEMP_HREF_PATH=//nha-fims.itbsstudio.com/temp_uploads/
# Windows local (when running PHP outside Docker): use your local project path.
UPLOAD_TEMP_HREF_PATH=//nha-fims.localhost/temp_uploads/
UPLOAD_DEST_PATH=s3://pg-itbs-dev/NHA-FIMS/

# ================================================
# PIMS (API Intergration)
# ================================================
# Single PPMS/PIMS API host — ACCOUNTING-BAPD builds every path
# (program-classifications, custom/fims_api, regions, districts,
# funding-classifications) off this one base. Change the host here only.
PIMS_API_BASE_URL=https://ppms.staging.nha.gov.ph/api/v1

# Legacy per-endpoint URLs — still read directly by FMD
# (FMD/app/services/integration/pimsProgramServices.php). Keep these in
# sync with PIMS_API_BASE_URL above until FMD is migrated too.
PIMS_API_URL=https://ppms.staging.nha.gov.ph/api/v1/program-classifications
PIMS_PROJECTS_API_URL=https://ppms.staging.nha.gov.ph/api/v1/custom/fims_api
PIMS_REGIONS_API_URL=https://ppms.staging.nha.gov.ph/api/v1/regions
PIMS_CLASSIFICATIONS_API_URL=https://ppms.staging.nha.gov.ph/api/v1/program-classifications
PIMS_DISTRICTS_API_URL=https://ppms.staging.nha.gov.ph/api/v1/districts
PIMS_FUNDING_CLASSIFICATIONS_API_URL=https://ppms.staging.nha.gov.ph/api/v1/funding-classifications

# ================================================
# PIMS (API TOKEN Intergration)
# ================================================

# Programs API token for authentication with PIMS API
PIMS_API_PROGRAM_TOKEN=your_api_token_here
PIMS_API_PROJECT_TOKEN=your_api_token_here
# Shared token for PIMS reference-data lookups (regions, classifications, districts, funding classifications)
PIMS_API_REFERENCE_TOKEN=your_api_token_here

# ================================================
# LIBIS (API Intergration)
# ================================================
LIBIS_API_URL=https://dev-libis-bcs-api.nhalibisproject.com/api/v1

# ================================================
# LIBIS (API TOKEN Intergration)
# ================================================
LIBIS_API_TOKEN=your_api_token_here

# ================================================
# PIS (Property Inventory System — inventory_by_po API)
# ================================================
# Property Records' own per-row "Sync Now" backfill — distinct from
# PIMS/PMS above. Auth is a raw "token" header, not "Authorization: Bearer".
PIS_API_BASE_URL=https://apigenerator.staging.nha.gov.ph/api
PIS_API_TOKEN=your_api_token_here

# ================================================
# ACTIVE DIRECTORY / LDAP
# Master switch — false disables AD entirely.
# ================================================
LDAP_ENABLED=false
LDAP_SERVER=ldaps://ldap.nha.gov.ph
LDAP_PORT=636
LDAP_DOMAIN=nha.gov.ph
LDAP_TIMEOUT=5
LDAP_TLS_INSECURE=false
LDAP_LOCAL_ACCOUNTS=superadmin,libis_service